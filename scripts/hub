#!/usr/bin/env sh
# OrigHub 统一控制入口（POSIX：Git Bash / WSL / Linux / macOS）。
#
# 与 `scripts/hub.cmd` 同一入口的两个壳：本文件给 sh 系，`.cmd` 给 Windows cmd/PowerShell。
# 逻辑全在 `hub.py`，两个壳只负责找到脚本目录并挑一个能用的解释器 ——
# 任何行为差异都属 BUG，必须改 `hub.py` 而不是在这两个壳里各自补丁。
#
#   ./scripts/hub dev start          # 一条命令起整个 dev 世界
#   ./scripts/hub dev status
#   ./scripts/hub release version 1.2.1
#   ./scripts/hub status

set -eu

# `$0` 可能是相对路径（用户在别处 `sh scripts/hub` 调用），dirname 之后必须 cd 取绝对路径，
# 否则 hub.py 里的 REPO 解析会跟着 cwd 跑偏（release 路径/tag 门禁全错）。
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for PY in python3 python py; do
    if command -v "$PY" >/dev/null 2>&1; then
        exec "$PY" "$DIR/hub.py" "$@"
    fi
done

echo "hub: no python interpreter found (tried: python3, python, py)" >&2
exit 1

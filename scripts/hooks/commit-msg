#!/bin/sh
# orig-hub commit-msg hook (tracked copy; install via scripts/install-hooks.sh)
#
# 两条规则：
#  1) EE rule（继承）：提交信息一律英文，subject/body 出现 CJK 即拒绝。
#  2) BUG rule（BUG-067）：`fix` 类提交必须引用 `BUG-<编号>`。
#     理由：审计发现 22 条 fix 提交里 **19 条不带编号**，缺陷修复只活在 git 历史里，
#     登记册无法回答「这条修没修」「这次修的是哪条」。修复必须先登记、再引用，
#     否则「绕过登记直接修」这个错误状态是可表达的 —— 本钩子让它不可表达。
#
# AGENTS.md: --no-verify 跳过钩子，除显式授权外一律禁止。
msg_file="$1"

if grep -qP '[\x{4e00}-\x{9fff}]' "$msg_file" 2>/dev/null; then
  echo "commit-msg: rejected - commit message contains Chinese (EE rule: English only)" >&2
  echo "  example: feat(engine): add series merge API (reorder only, no content check)" >&2
  exit 1
fi

subject="$(head -n 1 "$msg_file")"
case "$subject" in
  fix:*|fix\(*|fix!*)
    if ! grep -qE 'BUG-[0-9]{3}' "$msg_file"; then
      echo "commit-msg: rejected - fix commit must cite a registered bug id (BUG-067 rule)" >&2
      echo "  subject: $subject" >&2
      echo "  add the id to the body, e.g.:" >&2
      echo "    Refs: BUG-058" >&2
      echo "  if this is a defect nobody registered yet, register it first:" >&2
      echo "    docs/bugs/BUG-<next>.md + docs/bugs/README.md row" >&2
      exit 1
    fi
    ;;
esac

exit 0

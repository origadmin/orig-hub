#!/bin/sh
# orig-hub commit-msg hook (tracked copy; install via scripts/install-hooks.sh)
#
# 三条规则：
#  0) CRLF rule（BUG-084）：提交信息必须 LF，**出现一个 CR 即拒绝**。
#     理由：git 按字节哈希提交对象，message 里的 \r 会原样进入字节内容。本仓库根提交
#     206ee70 与 645d2c7 内容完全相同（同 tree 09b3465、同作者同时刻），仅因结尾
#     CRLF/LF 之差而哈希不同，并让**所有后代哈希全变**（78 条里 76 条 message 含 CR）。
#     单条提交信息永远是「新增」，故这里无历史豁免：命中即拒。
#  1) EE rule（继承）：提交信息一律英文，subject/body 出现 CJK 即拒绝。
#  2) BUG rule（BUG-067）：`fix` 类提交必须引用 `BUG-<编号>`。
#     理由：审计发现 22 条 fix 提交里 **19 条不带编号**，缺陷修复只活在 git 历史里，
#     登记册无法回答「这条修没修」「这次修的是哪条」。修复必须先登记、再引用，
#     否则「绕过登记直接修」这个错误状态是可表达的 —— 本钩子让它不可表达。
#
# AGENTS.md: --no-verify 跳过钩子，除显式授权外一律禁止。
msg_file="$1"

# CR 检测：`grep -P '\r'` 在本机（MSYS grep 3.0）匹配不到 CR，必须给**字面** CR 并加 -U
# （-U = 不做换行转换）。`$(printf '\r')` 是 POSIX 写法，不依赖 bash 的 $'\r'。
if grep -qU "$(printf '\r')" "$msg_file" 2>/dev/null; then
  echo "commit-msg: rejected - commit message contains CR (\r); LF is the only allowed line ending" >&2
  echo "  why: git hashes the commit object byte-for-byte, so a CR lands in the object bytes." >&2
  echo "       206ee70 and 645d2c7 are identical (tree 09b3465, same author/date) except for the" >&2
  echo "       trailing CRLF vs LF - hence different hashes, and every descendant re-hashes too." >&2
  echo "  fix: write the message with LF only (git config core.autocrlf input); do not paste" >&2
  echo "       CRLF text into -m/-F. Landed commits can only be cleaned by a history rewrite." >&2
  exit 1
fi

if grep -qP '[\x{4e00}-\x{9fff}]' "$msg_file" 2>/dev/null; then
  echo "commit-msg: rejected - commit message contains Chinese (EE rule: English only)" >&2
  echo "  example: feat(engine): add series merge API (reorder only, no content check)" >&2
  exit 1
fi

subject="$(head -n 1 "$msg_file")"
case "$subject" in
  fix:*|fix\(*|fix!*)
    if ! grep -qE 'BUG-[0-9]{3}' "$msg_file"; then
      echo "commit-msg: rejected - fix commit must cite a registered bug id (BUG-067 rule)" >&2
      echo "  subject: $subject" >&2
      echo "  add the id to the body, e.g.:" >&2
      echo "    Refs: BUG-058" >&2
      echo "  if this is a defect nobody registered yet, register it first:" >&2
      echo "    docs/bugs/BUG-<next>.md + docs/bugs/README.md row" >&2
      exit 1
    fi
    ;;
esac

exit 0

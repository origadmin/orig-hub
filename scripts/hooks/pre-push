#!/usr/bin/env sh
# orig-hub pre-push hook (tracked copy; install via scripts/install-hooks.sh)
#
# 「编码完成 / 交付前」的登记门禁（2026-10-26 用户裁定：从 pre-commit 挪来）。
# 本地提交要快，所以提交期不跑这两道；推送（=交付给团队）时跑，CI 的 `registry`
# job 兜底。构建（cargo build / npm run build）也在交付前做，但耗时，故不放进钩子，
# 由交付者按 AGENTS.md §2 手动执行。
#
#   1) check-bugs.py      缺陷登记一致性（编号连续 / 索引双向一致 / 字段枚举 / fixed 须有可核证据）
#   2) check-decisions.py 决策项可拍板性（D<n> 的选项/锚点/量化等）
#
# 两个依赖都已入库，任一缺失即失败（不静默跳过）。
ROOT="$(git rev-parse --show-toplevel)"

PY=""
if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "pre-push: FAIL - python not found, cannot run the registry gates" >&2
  exit 1
fi

rc=0
run_gate() {
  _script="$1"
  _label="$2"
  shift 2
  _path="$ROOT/scripts/$_script"
  if [ ! -f "$_path" ]; then
    echo "pre-push: FAIL - scripts/$_script missing ($_label gate is required)" >&2
    rc=1
    return 0
  fi
  "$PY" "$_path" "$@" || rc=1
}

run_gate check-bugs.py "bug registry" --quiet
run_gate check-decisions.py "decision decidability"

exit $rc

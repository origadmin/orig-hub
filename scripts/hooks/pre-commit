#!/usr/bin/env sh
# orig-hub pre-commit hook (tracked copy; install via scripts/install-hooks.sh)
#
# 2026-10-26 用户裁定：**提交要快**，提交期不跑任何 check-bugs / check-decisions，
# 也不跑构建。缺陷登记与决策项门禁属「编码完成、推送/交付前」的闸门，已移到
# pre-push（scripts/hooks/pre-push）与 CI 的 `registry` job。
#
# 提交期只保留**目录污染**这一道毫秒级卫生检查（扫暂存集，见 AGENTS.md §6/§7）。
#
# 历史（BUG-187）：本钩子曾把 check-bugs.py + check-decisions.py 串在提交里；
#   check-bugs 全量一度要 231s、后续提速到约 3s 仍属「内容门禁」，与「小步快提交」
#   直接冲突（本地提交被拖慢、多会话还会撞 index.lock）。2026-10-26 起一律挪到 pre-push。
ROOT="$(git rev-parse --show-toplevel)"
GATE="$ROOT/scripts/check-pollution.sh"
if [ ! -f "$GATE" ]; then
  echo "pre-commit: FAIL - scripts/check-pollution.sh missing (pollution gate is required)" >&2
  exit 1
fi
sh "$GATE"
exit $?
